{
  "name": "pi-recall",
  "version": "0.1.0",
  "description": "Hybrid (FTS5 + local embeddings) recall over pi's own session history, exposed to the model as `recall` / `recall_show`. Local-only; the index is derived and rebuildable; every call is logged for post-hoc evaluation.",
  "type": "module",
  "license": "MIT",
  "author": "Jane Doe",
  "keywords": ["pi-package", "pi", "pi-extension", "pi-coding-agent", "recall", "memory", "retrieval"],
  "pi": { "extensions": ["./extensions/recall.ts"] },
  "scripts": {
    "test": "node --test src/*.test.mjs",
    "test:integration": "PI_RECALL_INTEGRATION=1 node --test --test-timeout=300000 src/*.integration.mjs"
  },
  "dependencies": { "@huggingface/transformers": "^4.3.0" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "files": ["extensions", "src", "bin", "evals", "README.md"],
  "engines": { "node": ">=24.0.0" }
}
